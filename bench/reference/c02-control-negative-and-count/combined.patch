@@ -10,3 +10,8 @@ export function subtotal(items: Item[]): number {
 export function calculateTotal(items: Item[], promo?: Promo): number {
   return applyDiscount(subtotal(items), promo);
 }
+
+/** Number of units in the cart: the sum of all qty values. */
+export function itemCount(items: Item[]): number {
+  return items.reduce((sum, item) => sum + item.qty, 0);
