diff --git a/src/receipt.ts b/src/receipt.ts
new file mode 100644
index 0000000..3ca1580
--- /dev/null
+++ b/src/receipt.ts
@@ -0,0 +1,7 @@
+import { formatCents } from "./format.js";
+import type { Item } from "./types.js";
+
+/** One receipt line with unit price and line total: "pen x2 @ $2.50 = $5.00". */
+export function receiptLine(item: Item): string {
+  return `${item.sku} x${item.qty} @ ${formatCents(item.priceCents)} = ${formatCents(item.priceCents * item.qty)}`;
+}
