+import { describe, expect, it } from "vitest";
+import { receiptLine } from "../src/receipt.js";
+
+describe("receiptLine", () => {
+  it("shows unit price and line total", () => {
+    expect(receiptLine({ sku: "pen", priceCents: 250, qty: 2 })).toBe("pen x2 @ $2.50 = $5.00");
+  });
+
+  it("works for a single unit", () => {
+    expect(receiptLine({ sku: "mug", priceCents: 1000, qty: 1 })).toBe("mug x1 @ $10.00 = $10.00");
+  });
+});
