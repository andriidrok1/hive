+++ b/test/refunds.test.ts
@@ -0,0 +1,20 @@
+import { describe, expect, it } from "vitest";
+import { orderSummary } from "../src/order.js";
+import type { Item } from "../src/types.js";
+
+const cart: Item[] = [
+  { sku: "mug", priceCents: 1000, qty: 1 },
+  { sku: "pen", priceCents: 300, qty: -1 },
+];
+
+describe("refunds in orderSummary", () => {
+  it("shows a refund line", () => {
+    expect(orderSummary(cart).lines).toEqual(["mug x1 $10.00", "Refund pen x1 -$3.00", "Subtotal $7.00", "Total $7.00"]);
+  });
+
+  it("reduces subtotal and total", () => {
+    const summary = orderSummary(cart);
+    expect(summary.subtotal).toBe(700);
+    expect(summary.total).toBe(700);
+  });
+});
