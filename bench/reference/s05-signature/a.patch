-/** Formats whole cents as a dollar string: 1234 -> "$12.34". */
-export function formatPrice(cents: number): string {
+export type Currency = "USD" | "EUR";
+
+const SYMBOLS: Record<Currency, string> = { USD: "$", EUR: "€" };
+
+/** Formats whole cents in the given currency: (1234, "USD") -> "$12.34". */
+export function formatPrice(cents: number, currency: Currency): string {
+  const symbol = SYMBOLS[currency];
+  if (!symbol) throw new Error(`Unknown currency: ${String(currency)}`);
   const dollars = Math.floor(cents / 100);
   const rest = cents % 100;
-  return `$${dollars}.${String(rest).padStart(2, "0")}`;
+  return `${symbol}${dollars}.${String(rest).padStart(2, "0")}`;
 }
