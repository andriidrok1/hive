+import { describe, expect, it } from "vitest";
+import { receiptTotalLine } from "../src/order.js";
+import type { Item } from "../src/types.js";
+
+const items: Item[] = [
+  { sku: "mug", priceCents: 1000, qty: 1 },
+  { sku: "pen", priceCents: 250, qty: 2 },
+];
+
+describe("receiptTotalLine", () => {
+  it("shows the total", () => {
+    expect(receiptTotalLine(items)).toBe("TOTAL $15.00");
+  });
+
+  it("applies the promo", () => {
+    expect(receiptTotalLine(items, { code: "TEN", kind: "percent", value: 10 })).toBe("TOTAL $13.50");
+  });
+});
