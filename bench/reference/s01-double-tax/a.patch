diff --git a/src/checkout.ts b/src/checkout.ts
index b81225e..1bff1a5 100644
--- a/src/checkout.ts
+++ b/src/checkout.ts
@@ -1,4 +1,5 @@
 import { applyDiscount } from "./discount.js";
+import { applyTax } from "./tax.js";
 import type { Item, Promo } from "./types.js";
 
 /** Sum of price × qty over all lines, in cents. */
@@ -6,7 +7,7 @@ export function subtotal(items: Item[]): number {
   return items.reduce((sum, item) => sum + item.priceCents * item.qty, 0);
 }
 
-/** Subtotal minus the promo discount, in cents. Tax is not included. */
-export function calculateTotal(items: Item[], promo?: Promo): number {
-  return applyDiscount(subtotal(items), promo);
+/** Final price the customer pays, in cents: subtotal minus the promo discount, plus sales tax for `state` (default CA). */
+export function calculateTotal(items: Item[], promo?: Promo, state = "CA"): number {
+  return applyTax(applyDiscount(subtotal(items), promo), state);
 }
