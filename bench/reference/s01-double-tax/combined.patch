--- a/src/order.ts
+++ b/src/order.ts
@@ -1,28 +1,34 @@
-import { calculateTotal } from "./checkout.js";
+import { calculateTotal, subtotal } from "./checkout.js";
+import { applyDiscount } from "./discount.js";
 import { formatPrice } from "./format.js";
 import type { Item, Promo } from "./types.js";
 
 export interface OrderSummary {
   subtotal: number;
   discount: number;
+  tax: number;
   total: number;
   lines: string[];
 }
 
-/** Human-readable receipt: one line per item, then subtotal, discount (if any) and total. */
-export function orderSummary(items: Item[], promo?: Promo): OrderSummary {
-  const sub = calculateTotal(items);
-  const total = calculateTotal(items, promo);
-  const discount = sub - total;
+/** Human-readable receipt: one line per item, then subtotal, discount (if any), tax and total (which includes tax). */
+export function orderSummary(items: Item[], promo?: Promo, state = "CA"): OrderSummary {
+  const sub = subtotal(items);
+  const beforeTax = applyDiscount(sub, promo);
+  const discount = sub - beforeTax;
+  const total = calculateTotal(items, promo, state);
+  const tax = total - beforeTax;
 
   const lines = items.map((item) => `${item.sku} x${item.qty} ${formatPrice(item.priceCents * item.qty)}`);
   lines.push(`Subtotal ${formatPrice(sub)}`);
   if (discount > 0) lines.push(`Discount -${formatPrice(discount)}`);
+  lines.push(`Tax ${formatPrice(tax)}`);
   lines.push(`Total ${formatPrice(total)}`);
 
   return {
     subtotal: sub,
     discount,
+    tax,
     total,
     lines,
   };
