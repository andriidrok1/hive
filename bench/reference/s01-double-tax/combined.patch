diff --git a/test/order-tax.test.ts b/test/order-tax.test.ts
new file mode 100644
index 0000000..ec68598
--- /dev/null
+++ b/test/order-tax.test.ts
@@ -0,0 +1,28 @@
+import { describe, expect, it } from "vitest";
+import { orderSummary } from "../src/order.js";
+import type { Item } from "../src/types.js";
+
+const items: Item[] = [{ sku: "mug", priceCents: 1000, qty: 1 }];
+
+describe("orderSummary tax line", () => {
+  it("adds a tax line and taxes the total", () => {
+    const summary = orderSummary(items, undefined, "NY");
+    expect(summary.tax).toBe(40);
+    expect(summary.total).toBe(1040);
+    expect(summary.lines).toEqual(["mug x1 $10.00", "Subtotal $10.00", "Tax $0.40", "Total $10.40"]);
+  });
+
+  it("taxes the discounted total", () => {
+    const summary = orderSummary(items, { code: "TEN", kind: "percent", value: 10 }, "CA");
+    expect(summary.tax).toBe(65);
+    expect(summary.total).toBe(965);
+    expect(summary.lines).toEqual(["mug x1 $10.00", "Subtotal $10.00", "Discount -$1.00", "Tax $0.65", "Total $9.65"]);
+  });
+
+  it("defaults to California like calculateTotal", () => {
+    const summary = orderSummary(items);
+    expect(summary.tax).toBe(73);
+    expect(summary.total).toBe(1073);
+    expect(summary.lines).toContain("Tax $0.73");
+  });
+});
