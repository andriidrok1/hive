diff --git a/test/total-with-tax.test.ts b/test/total-with-tax.test.ts
new file mode 100644
index 0000000..aa67837
--- /dev/null
+++ b/test/total-with-tax.test.ts
@@ -0,0 +1,19 @@
+import { describe, expect, it } from "vitest";
+import { totalWithTax } from "../src/tax.js";
+import type { Item } from "../src/types.js";
+
+const gum: Item[] = [{ sku: "gum", priceCents: 25, qty: 1 }];
+
+describe("totalWithTax", () => {
+  it("taxes the discounted total", () => {
+    expect(totalWithTax([{ sku: "mug", priceCents: 1000, qty: 1 }], { code: "TEN", kind: "percent", value: 10 }, "NY")).toBe(936);
+  });
+
+  it("rounds once: 12.5 cents with 4% tax is 13 cents", () => {
+    expect(totalWithTax(gum, { code: "HALF", kind: "percent", value: 50 }, "NY")).toBe(13);
+  });
+
+  it("charges no tax in Oregon", () => {
+    expect(totalWithTax(gum, undefined, "OR")).toBe(25);
+  });
+});
