diff --git a/src/tax.ts b/src/tax.ts
index 5ab7de9..b1ee602 100644
--- a/src/tax.ts
+++ b/src/tax.ts
@@ -1,3 +1,7 @@
+import { subtotal } from "./checkout.js";
+import { applyDiscount } from "./discount.js";
+import type { Item, Promo } from "./types.js";
+
 /** Sales tax rate per US state code. */
 export const TAX_RATES: Record<string, number> = {
   CA: 0.0725,
@@ -12,3 +16,8 @@ export function applyTax(totalCents: number, state: string): number {
   if (rate === undefined) throw new Error(`Unknown state: ${state}`);
   return Math.round(totalCents * (1 + rate));
 }
+
+/** Final taxed price of a cart: tax applies to the exact discounted amount, rounding happens once. */
+export function totalWithTax(items: Item[], promo: Promo | undefined, state: string): number {
+  return applyTax(applyDiscount(subtotal(items), promo), state);
+}
