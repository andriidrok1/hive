+import type { Promo } from "./types.js";
+
+/** Promo codes the store currently accepts. */
+export const PROMOS: Record<string, Promo> = {
+  WELCOME5: { code: "WELCOME5", kind: "fixed", value: 500 },
+};
+
+/** Looks a code up case-insensitively. */
+export function findPromo(code: string): Promo | undefined {
+  return PROMOS[code.toUpperCase()];
+}
