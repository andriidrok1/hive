+++ b/test/promos.test.ts
@@ -0,0 +1,14 @@
+import { describe, expect, it } from "vitest";
+import { calculateTotal } from "../src/checkout.js";
+import { PROMOS, findPromo } from "../src/promos.js";
+
+describe("promos", () => {
+  it("finds codes case-insensitively", () => {
+    expect(findPromo("welcome5")).toBe(PROMOS.WELCOME5);
+    expect(findPromo("NOPE")).toBeUndefined();
+  });
+
+  it("WELCOME5 takes $5 off a $20 cart", () => {
+    expect(calculateTotal([{ sku: "mug", priceCents: 2000, qty: 1 }], PROMOS.WELCOME5)).toBe(1500);
+  });
+});
