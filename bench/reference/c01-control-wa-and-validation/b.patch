diff --git a/src/discount.ts b/src/discount.ts
index b89cce2..cccea3a 100644
--- a/src/discount.ts
+++ b/src/discount.ts
@@ -6,6 +6,9 @@ import type { Promo } from "./types.js";
  */
 export function applyDiscount(subtotalCents: number, promo?: Promo): number {
   if (!promo) return subtotalCents;
+  if (promo.kind === "percent" && (promo.value < 0 || promo.value > 100)) {
+    throw new Error(`Invalid percent promo ${promo.code}: value must be between 0 and 100`);
+  }
   const discount = promo.kind === "percent" ? (subtotalCents * promo.value) / 100 : promo.value;
   return Math.max(0, subtotalCents - discount);
 }
