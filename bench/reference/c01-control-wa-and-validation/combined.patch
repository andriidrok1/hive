@@ -14,6 +14,18 @@ describe("applyDiscount", () => {
     expect(applyDiscount(1000, { code: "OFF250", kind: "fixed", value: 250 })).toBe(750);
   });
 
+  it("accepts percent values between 0 and 100", () => {
+    expect(applyDiscount(1000, { code: "ALL", kind: "percent", value: 100 })).toBe(0);
+  });
+
+  it("rejects percent values above 100", () => {
+    expect(() => applyDiscount(1000, { code: "BAD", kind: "percent", value: 150 })).toThrow(/percent/);
+  });
+
+  it("rejects negative percent values", () => {
+    expect(() => applyDiscount(1000, { code: "NEG", kind: "percent", value: -5 })).toThrow(/percent/);
+  });
+
   it("never goes below zero", () => {
     expect(applyDiscount(200, { code: "BIG", kind: "fixed", value: 500 })).toBe(0);
   });
